          },
          "docs": "As [`Terms::cancel_authority`]."
        },
        {
          "name": "milestone_authority",
          "type": {
            "option": "account_id"
          },
          "docs": "As [`Terms::milestone_authority`]."
        },
        {
          "name": "refund_to",
          "type": {
            "option": "account_id"
          },
          "docs": "As [`Terms::refund_to`]."
        }
