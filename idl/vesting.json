          "docs": "The schedule account."
        },
        {
          "name": "schedule_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          },
          "docs": "The id the creator chose; with `creator` it derives `schedule`."
        },
        {
          "name": "creator",
          "type": "account_id",
          "docs": "Its creator."
        },
        {
          "name": "beneficiary",
          "type": "account_id",
          "docs": "Its beneficiary."
        },
        {
          "name": "asset",
          "type": {
            "defined": "Asset"
          },
          "docs": "The vested asset."
        },
        {
          "name": "total",
          "type": "u128",
          "docs": "The escrowed total."
        },
        {
          "name": "kind",
          "type": {
            "defined": "Kind"
          },
          "docs": "The curve."
        },
        {
          "name": "cancelable",
          "type": "bool",
          "docs": "The cancelable flag."
        },
        {
          "name": "transferable",
          "type": "bool",
          "docs": "The transferable flag."
        },
        {
          "name": "cancel_authority",
          "type": "account_id",
          "docs": "Who may cancel."
        },
        {
          "name": "milestone_authority",
          "type": "account_id",
          "docs": "Who may signal milestones."
        },
        {
          "name": "refund_to",
          "type": "account_id",
          "docs": "Where a cancel refunds to."
        }
      ]
    },
    {
      "name": "ScheduleState",
      "kind": "enum",
      "variants": [
        {
          "name": "V1",
          "fields": [
            {
              "name": "0",
              "type": {
                "defined": "ScheduleV1"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ScheduleV1",
      "kind": "struct",
      "fields": [
        {
          "name": "schedule_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          },
          "docs": "Chosen by the creator; with `creator` it derives the schedule account."
        },
        {
          "name": "creator",
          "type": "account_id",
          "docs": "The account that created and funded the schedule."
        },
        {
          "name": "beneficiary",
          "type": "account_id",
          "docs": "Who may claim. Changes only by `TransferBeneficiary`, and only when `transferable`."
        },
        {
          "name": "asset",
          "type": {
            "defined": "Asset"
          },
          "docs": "What is vested."
        },
        {
          "name": "total",
          "type": "u128",
          "docs": "Escrowed at creation; greater than zero."
        },
        {
          "name": "claimed",
          "type": "u128",
          "docs": "Paid out so far; never more than the vested amount at `last_time`."
        },
        {
          "name": "last_time",
          "type": "u64",
          "docs": "High-water time (ms): the latest time a claim or cancel was computed at; 0 until the first one. Every claim\nand cancel is computed at `max(t, last_time)`, so the clock read and a claimant's `as_of` act as one\nnon-decreasing time source per schedule."
        },
        {
          "name": "kind",
          "type": {
            "defined": "Kind"
          },
          "docs": "The vesting curve."
        },
        {
          "name": "cancelable",
          "type": "bool",
          "docs": "`true` to `false` only (`MakeNonCancelable`)."
        },
        {
          "name": "transferable",
          "type": "bool",
          "docs": "Written at creation, never changed."
        },
        {
          "name": "cancel_authority",
          "type": "account_id",
          "docs": "May cancel. Default: the creator."
        },
        {
          "name": "milestone_authority",
          "type": "account_id",
          "docs": "May signal milestones. Default: the creator."
        },
        {
          "name": "refund_to",
          "type": "account_id",
          "docs": "Receives the unvested part on cancel. Default: the funding account (`source`). Fixed at creation."
        },
        {
          "name": "cancelled",
          "type": {
            "option": {
              "defined": "Cancellation"
            }
          },
          "docs": "Set once by a cancel."
        },
        {
          "name": "pending",
          "type": {
            "option": {
              "defined": "Pending"
            }
          },
          "docs": "An operation waiting for the clock reply; `Some` only inside one transaction."
        }
      ]
    },
    {
      "name": "Terms",
      "kind": "struct",
      "fields": [
        {
          "name": "beneficiary",
          "type": "account_id",
          "docs": "Who may claim."
        },
        {
          "name": "asset",
          "type": {
            "defined": "Asset"
          },
          "docs": "What is vested."
        },
        {
          "name": "total",
          "type": "u128",
          "docs": "Amount escrowed; greater than zero."
        },
        {
          "name": "kind",
          "type": {
            "defined": "Kind"
          },
          "docs": "The vesting curve. `Milestones.signalled` must be 0."
        },
        {
          "name": "cancelable",
          "type": "bool",
          "docs": "SDK default: `true`."
        },
        {
          "name": "transferable",
          "type": "bool",
          "docs": "SDK default: `false`."
        },
        {
          "name": "cancel_authority",
          "type": {
            "option": "account_id"
          },
          "docs": "`None`: the creator."
        },
        {
          "name": "milestone_authority",
          "type": {
            "option": "account_id"
          },
          "docs": "`None`: the creator."
        },
        {
          "name": "refund_to",
          "type": {
            "option": "account_id"
          },
          "docs": "`None`: the funding account (`source` of the creation message)."
        }
      ]
    }
  ],
  "internal_messages": [
    {
      "name": "Open",
      "tag": 0,
      "docs": "Tag 0: write a new schedule. Accepted only from `(state.creator, vesting)` at the derived account.",
      "fields": [
        {
          "name": "state",
          "type": {
            "defined": "ScheduleV1"
          },
          "docs": "The complete initial state, checked with [`ScheduleV1::validate_new`]."
        }
      ]
    },
    {
      "name": "ClaimFor",
      "tag": 1,
      "docs": "Tag 1: a public claim to `to`; completes on the clock reply.",
      "fields": [
        {
          "name": "to",
          "type": "account_id",
          "docs": "The payout destination."
        }
      ]
    },
    {
      "name": "ClaimForAsOf",
      "tag": 2,
      "docs": "Tag 2: a claim computed at `as_of`.",
      "fields": [
        {
          "name": "to",
          "type": "account_id",
          "docs": "The payout destination."
        },
        {
          "name": "as_of",
