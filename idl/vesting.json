          "docs": "The time the claim is computed at (ms)."
        }
      ]
    },
    {
      "name": "CancelFor",
      "tag": 3,
      "docs": "Tag 3: a cancel; completes on the clock reply."
    },
    {
      "name": "MakeNonCancelableFor",
      "tag": 4,
      "docs": "Tag 4: make the schedule non-cancelable."
    },
    {
      "name": "SignalFor",
      "tag": 5,
      "docs": "Tag 5: signal milestone `index`.",
      "fields": [
        {
          "name": "index",
          "type": "u8",
          "docs": "The milestone index."
        }
      ]
    },
    {
      "name": "TransferFor",
      "tag": 6,
      "docs": "Tag 6: hand the schedule to `new_beneficiary`.",
      "fields": [
        {
          "name": "new_beneficiary",
          "type": "account_id",
          "docs": "The new beneficiary."
        }
      ]
    }
  ],
  "errors": [
    {
      "code": 1,
      "name": "NotAuthorised",
      "msg": "the caller did not authorise this transaction"
    },
    {
      "code": 2,
      "name": "InvalidMessage",
      "msg": "the message does not decode"
    },
    {
      "code": 3,
      "name": "NotBeneficiary",
      "msg": "only the beneficiary may do this"
    },
    {
      "code": 4,
      "name": "NotCreator",
      "msg": "only the creator or the cancel authority may do this"
    },
    {
      "code": 5,
      "name": "NotCancelAuthority",
      "msg": "only the cancel authority may cancel"
    },
    {
      "code": 6,
      "name": "NotMilestoneAuthority",
      "msg": "only the milestone authority may signal a milestone"
    },
    {
      "code": 7,
      "name": "ScheduleExists",
      "msg": "a schedule with this id already exists for this creator"
    },
    {
      "code": 8,
      "name": "NoSuchSchedule",
      "msg": "no schedule at this account"
    },
    {
      "code": 9,
      "name": "AddressMismatch",
      "msg": "the schedule account does not match the creator and schedule id"
    },
    {
      "code": 10,
      "name": "ZeroTotal",
      "msg": "the total must be greater than zero"
    },
    {
      "code": 11,
      "name": "BadTimes",
      "msg": "times must satisfy start <= cliff <= end and start < end"
    },
    {
      "code": 12,
      "name": "BadMilestones",
      "msg": "milestone amounts must be non-zero and sum to the total"
    },
    {
