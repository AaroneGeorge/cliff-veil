          "docs": "The schedule account."
        },
        {
          "name": "from",
          "type": "account_id",
          "docs": "The previous beneficiary."
        },
        {
          "name": "to",
          "type": "account_id",
          "docs": "The new beneficiary."
        }
      ]
    },
    {
      "name": "Cancellation",
      "kind": "struct",
      "fields": [
        {
          "name": "at",
