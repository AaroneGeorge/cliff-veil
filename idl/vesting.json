{
  "version": "2",
  "name": "vesting",
  "messages": [
    {
      "name": "Create",
      "tag": 0,
      "docs": "Tag 0: open one schedule and fund its escrow from `source`; the caller becomes the creator.",
      "fields": [
        {
          "name": "schedule_id",
          "type": {
            "array": [
              "u8",
              32
            ]
          },
          "docs": "Chosen by the creator; with the creator it derives the schedule account."
        },
        {
          "name": "terms",
          "type": {
            "defined": "Terms"
          },
          "docs": "The schedule's terms."
        },
        {
          "name": "source",
          "type": "account_id",
          "docs": "Funding account (native balance, or token holding of the definition). Default refund account."
        },
        {
          "name": "fee",
          "type": "u128",
          "docs": "The creation fee the SDK quoted; checked by `vesting_fees`, and against the hard cap by `vesting`."
        },
        {
          "name": "treasury",
          "type": "account_id",
          "docs": "The fee treasury the SDK read from the `vesting_fees` config; checked by `vesting_fees` when `fee > 0`."
        }
      ]
    },
    {
      "name": "CreateBatch",
      "tag": 1,
      "docs": "Tag 1: open one schedule per item, sharing `common`, in one transaction.",
      "fields": [
        {
          "name": "common",
          "type": {
            "defined": "BatchTerms"
          },
          "docs": "Terms shared by every item."
        },
        {
          "name": "items",
          "type": {
            "vec": {
              "defined": "BatchItem"
            }
          },
          "docs": "One schedule each."
        },
        {
          "name": "source",
          "type": "account_id",
          "docs": "Funding account. Default refund account of every item."
        },
        {
          "name": "fee",
          "type": "u128",
          "docs": "The creation fee on the sum of item totals."
        },
        {
          "name": "treasury",
          "type": "account_id",
          "docs": "The fee treasury, as in `Create`."
        }
      ]
    },
    {
      "name": "Claim",
      "tag": 2,
      "docs": "Tag 2: pay everything claimable now (clock time) to `to`.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "to",
          "type": "account_id",
          "docs": "The payout destination; never stored or emitted."
        }
      ]
    },
    {
      "name": "ClaimAsOf",
      "tag": 3,
      "docs": "Tag 3: pay everything claimable at `as_of` to `to`; the transaction is valid from `as_of` on.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "to",
          "type": "account_id",
          "docs": "The payout destination; never stored or emitted. On the privacy-preserving path, a one-time blinded\naddress of the claimant's private account (SPEC 9), never its canonical id."
        },
        {
          "name": "as_of",
          "type": "u64",
          "docs": "The time the claim is computed at (ms); the claim is computed at `max(as_of, last_time)`."
        }
      ]
    },
    {
      "name": "Cancel",
      "tag": 4,
      "docs": "Tag 4: cancel, refunding the unvested part.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        }
      ]
    },
    {
      "name": "MakeNonCancelable",
      "tag": 5,
      "docs": "Tag 5: make the schedule non-cancelable, for good.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        }
      ]
    },
    {
      "name": "SignalMilestone",
      "tag": 6,
      "docs": "Tag 6: signal milestone `index`.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "index",
          "type": "u8",
          "docs": "The milestone index."
        }
      ]
    },
    {
      "name": "TransferBeneficiary",
      "tag": 7,
      "docs": "Tag 7: hand the schedule to `new_beneficiary`.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "new_beneficiary",
          "type": "account_id",
          "docs": "The new beneficiary."
        }
      ]
    }
  ],
  "state_types": [
    "ScheduleState"
  ],
