          "type": "u8",
          "docs": "The milestone index."
        },
        {
          "name": "amount",
          "type": "u128",
          "docs": "The amount it unlocked."
        },
        {
          "name": "signalled",
          "type": "u64",
          "docs": "The bitmap after the signal."
        }
      ]
    },
    {
      "name": "Pending",
