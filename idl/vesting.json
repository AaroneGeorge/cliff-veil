        },
        {
          "name": "vested_at_cancel",
          "type": "u128",
          "docs": "The vested amount, frozen at the cancel."
        },
        {
          "name": "refunded",
          "type": "u128",
          "docs": "Paid to `refund_to`: `total - vested_at_cancel`."
        }
      ]
    },
    {
      "name": "Cancelled",
      "kind": "struct",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "at",
          "type": "u64",
          "docs": "Effective time of the cancel: `max(clock time, last_time)`."
        },
        {
          "name": "vested_at_cancel",
          "type": "u128",
          "docs": "The vested amount, frozen."
        },
        {
          "name": "refunded",
          "type": "u128",
          "docs": "Paid to `refund_to`."
        },
        {
          "name": "refund_to",
          "type": "account_id",
          "docs": "The refund account."
        }
      ]
    },
    {
      "name": "Claimed",
      "kind": "struct",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "beneficiary",
          "type": "account_id",
          "docs": "The beneficiary that claimed."
        },
        {
          "name": "amount",
          "type": "u128",
          "docs": "Paid by this claim."
        },
        {
          "name": "at",
          "type": "u64",
          "docs": "The effective time the claim was computed at: `max(clock time or as_of, last_time)`."
        },
        {
          "name": "claimed_total",
          "type": "u128",
          "docs": "`claimed` after this claim."
        }
      ]
    },
    {
      "name": "FeeChanged",
      "kind": "struct",
      "fields": [
        {
          "name": "old_rate_bps",
          "type": "u16",
          "docs": "The rate before, in basis points."
        },
        {
          "name": "new_rate_bps",
          "type": "u16",
          "docs": "The rate after, in basis points."
        },
        {
          "name": "treasury",
          "type": "account_id",
          "docs": "The treasury after."
        },
        {
          "name": "by",
          "type": "account_id",
          "docs": "The admin who changed it."
        }
      ]
    },
    {
      "name": "Kind",
      "kind": "enum",
      "variants": [
        {
          "name": "Linear",
          "fields": [
            {
              "name": "start",
              "type": "u64",
              "docs": "Accrual is measured from here (ms)."
            },
            {
              "name": "cliff",
              "type": "u64",
              "docs": "Nothing is vested before this time (ms)."
            },
            {
              "name": "end",
              "type": "u64",
              "docs": "Everything is vested from this time on (ms)."
            }
          ]
        },
        {
          "name": "Milestones",
          "fields": [
            {
              "name": "amounts",
              "type": {
                "vec": "u128"
              },
              "docs": "Amount unlocked by milestone `i`."
            },
            {
              "name": "signalled",
              "type": "u64",
              "docs": "Bit `i` set: milestone `i` was signalled."
            }
          ]
        }
      ]
    },
    {
      "name": "MadeNonCancelable",
      "kind": "struct",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id",
          "docs": "The schedule account."
        },
        {
          "name": "by",
          "type": "account_id",
          "docs": "Who did it (the creator or the cancel authority)."
        }
      ]
    },
    {
      "name": "MilestoneSignalled",
      "kind": "struct",
