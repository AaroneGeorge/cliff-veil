#!/usr/bin/env bash
# Checks every commit about to be pushed with scripts/check_history.sh (identity, no merges, no trailers, wording).
set -euo pipefail
hooks="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
zero=0000000000000000000000000000000000000000
remote="${1:-origin}"
fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    first="$(git rev-list --reverse "$local_sha" --not --remotes="$remote" | head -1)"
    [ -n "$first" ] || continue
    if git rev-parse -q --verify "$first^" >/dev/null; then range="$first^..$local_sha"; else range="$local_sha"; fi
  else
    range="$remote_sha..$local_sha"
  fi
  "$hooks/../check_history.sh" "$range" || fail=1
done
exit "$fail"
