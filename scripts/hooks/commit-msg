#!/usr/bin/env bash
# Rejects a commit message that carries any trailer line ("Signed-off-by:", "Reviewed-by:", ...) or a term on
# the wording list (scripts/hooks/wording.py).
set -euo pipefail
hooks="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/hooks/identity.sh
source "$hooks/identity.sh"
msg="${1:?commit message file}"
fail=0
body="$(git stripspace --strip-comments < "$msg")"
trailers="$( { printf '%s\n' "$body" | git interpret-trailers --parse; printf '%s\n' "$body" | grep -i -E "$CV_TRAILER_RE"; } | sort -u || true)"
if [ -n "$trailers" ]; then
  echo "commit-msg: trailers are not used in this repository:" >&2
  printf '%s\n' "$trailers" | sed 's/^/  /' >&2; fail=1
fi
if ! report="$(python3 -I "$hooks/wording.py" --message "$msg")"; then
  echo "commit-msg: message fails the wording check:" >&2
  printf '%s\n' "$report" | sed 's/^/  /' >&2; fail=1
fi
exit "$fail"
